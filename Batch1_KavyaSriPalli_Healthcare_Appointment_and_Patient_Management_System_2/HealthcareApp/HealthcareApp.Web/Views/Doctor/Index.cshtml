@model IEnumerable<HealthcareApp.BLL.DTOs.DoctorDTO>

@{
    ViewData["Title"] = "Doctors";
}

<div class="container mt-4">

    <!-- HEADER -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Doctor Management</h2>

        <a href="/Doctor/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Doctor
        </a>
    </div>

    <!-- SEARCH -->
    <div class="card shadow-sm p-3 mb-4">
        <input type="text"
               id="searchBox"
               class="form-control"
               placeholder="Search by name or specialization..."
               onkeyup="searchDoctor()" />
    </div>

    <!-- TABLE -->
    <div class="card shadow-sm p-3">

        <div class="table-responsive">
            <table class="table table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>ID</th>
                        <th>Name</th>
                        <th>Specialization</th>
                        <th>Available From</th>
                        <th>Available To</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model != null && Model.Any())
                    {
                        foreach (var d in Model)
                        {
                            <tr>
                                <td>@d.DoctorId</td>
                                <td class="fw-semibold">@d.Name</td>
                                <td>@d.Specialization</td>
                                <td>@d.AvailableFrom.ToString(@"hh\:mm")</td>
                                <td>@d.AvailableTo.ToString(@"hh\:mm")</td>

                                <td class="text-center">

                                    <a href="/Doctor/Edit/@d.DoctorId"
                                           class="btn btn-sm btn-outline-warning me-2">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <a href="/Doctor/Delete/@d.DoctorId"
                                           class="btn btn-sm btn-outline-danger"
                                           onclick="return confirm('Delete this doctor?')">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="6" class="text-center text-muted">
                                No doctors found
                            </td>
                        </tr>
                    }
                </tbody>

            </table>
        </div>

    </div>

</div>

<script>
    function searchDoctor() {
        var input = document.getElementById("searchBox").value.toLowerCase();
        var rows = document.querySelectorAll("table tbody tr");

        rows.forEach(row => {
            var name = row.cells[1].innerText.toLowerCase();
            var spec = row.cells[2].innerText.toLowerCase();

            row.style.display = (name.includes(input) || spec.includes(input)) ? "" : "none";
        });
    }
</script>