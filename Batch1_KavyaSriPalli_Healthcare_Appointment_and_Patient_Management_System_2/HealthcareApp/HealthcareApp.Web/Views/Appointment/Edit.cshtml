@model HealthcareApp.BLL.DTOs.AppointmentDTO

@{
    ViewData["Title"] = "Edit Appointment";
}

<div class="container mt-4">

    <div class="card shadow-sm p-4">

        <h3 class="mb-3">Edit Appointment</h3>

        <form asp-action="Edit" method="post">

            <input type="hidden" asp-for="AppointmentId" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="row">

                <!-- PATIENT -->
                <div class="col-md-6 mb-3">
                    <label>Patient</label>
                    <select asp-for="PatientId" asp-items="ViewBag.Patients" class="form-control" id="PatientId">
                        <option value="0">-- Select Patient --</option>
                    </select>
                    <span asp-validation-for="PatientId" class="text-danger"></span>
                </div>

                <!-- DOCTOR -->
                <div class="col-md-6 mb-3">
                    <label>Doctor</label>
                    <select asp-for="DoctorId" asp-items="ViewBag.Doctors" class="form-control" id="DoctorId">
                        <option value="0">-- Select Doctor --</option>
                    </select>
                    <span asp-validation-for="DoctorId" class="text-danger"></span>
                </div>

                <!-- DATE -->
                <div class="col-md-6 mb-3">
                    <label>Date</label>
                    <input asp-for="Date" type="date" class="form-control" id="Date" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>

                <!-- TIME SLOT -->
                <div class="col-md-6 mb-3">
                    <label>Time Slot</label>
                    <select asp-for="TimeSlot" class="form-control" id="timeDropdown">
                        <option value="">-- Select Time --</option>
                    </select>
                    <span asp-validation-for="TimeSlot" class="text-danger"></span>
                </div>

                <!-- STATUS -->
                <div class="col-md-6 mb-3">
                    <label>Status</label>
                    <select asp-for="Status" class="form-control">
                        <option value="1">Booked</option>
                        <option value="2">Completed</option>
                        <option value="3">Cancelled</option>
                    </select>
                </div>

            </div>

            <button type="submit" class="btn btn-primary">
                <i class="bi bi-save"></i> Update
            </button>

        </form>

    </div>

</div>

<!-- SCRIPTS -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        const doctor = document.getElementById("DoctorId");
        const date = document.getElementById("Date");
        const dropdown = document.getElementById("timeDropdown");

        const appointmentId = "@Model.AppointmentId";
        const existingTime = "@Model.TimeSlot.ToString("hh\\:mm")";

        function loadSlots() {

            let doctorId = doctor.value;
            let selectedDate = date.value;

            if (!doctorId || doctorId == "0" || !selectedDate) return;

            fetch(`/Appointment/GetAvailableSlots?doctorId=${doctorId}&date=${selectedDate}&appointmentId=${appointmentId}`)
                .then(res => res.json())
                .then(data => {

                    dropdown.innerHTML = '<option value="">-- Select Time --</option>';

                    data.forEach(slot => {

                        if (slot.isBooked && slot.time !== existingTime) {
                            dropdown.innerHTML += `<option value="${slot.time}" disabled>${slot.time} (Booked)</option>`;
                        } else {
                            dropdown.innerHTML += `<option value="${slot.time}">${slot.time}</option>`;
                        }

                    });

                    // SET SELECTED VALUE
                    dropdown.value = existingTime;
                });
        }

        //  LOAD ON PAGE OPEN
        loadSlots();

        //  LOAD ON CHANGE
        doctor.addEventListener("change", loadSlots);
        date.addEventListener("change", loadSlots);
    });
</script>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}