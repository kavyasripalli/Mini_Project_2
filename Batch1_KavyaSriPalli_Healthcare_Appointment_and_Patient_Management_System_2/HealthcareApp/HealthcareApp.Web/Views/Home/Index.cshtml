@{
    ViewData["Title"] = "Dashboard";
}

<div class="container mt-4">

    <!-- HERO SECTION -->
    <div class="p-5 rounded shadow-sm mb-4" style="background: linear-gradient(90deg, #56ab2f, #a8e063); color:white;">
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <h2 class="fw-bold">Welcome to MediSphere</h2>
                <p>Manage patients, doctors, and appointments efficiently.</p>
            </div>
            <a href="/Appointment/Create" class="btn btn-light fw-bold">Book Appointment</a>
        </div>
    </div>

    <!-- STATS CARDS -->
    <div class="row text-center mb-4">

        <div class="col-md-4">
            <div class="card shadow border-0 p-3">
                <i class="bi bi-people-fill text-primary fs-1"></i>
                <h4 class="mt-2">Patients</h4>
                <h2>@ViewBag.PatientCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0 p-3">
                <i class="bi bi-person-badge-fill text-success fs-1"></i>
                <h4 class="mt-2">Doctors</h4>
                <h2>@ViewBag.DoctorCount</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow border-0 p-3">
                <i class="bi bi-calendar-check-fill text-warning fs-1"></i>
                <h4 class="mt-2">Appointments</h4>
                <h2>@ViewBag.AppointmentCount</h2>
            </div>
        </div>

    </div>

    <!-- ACTION CARDS -->
    <div class="row">

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5><i class="bi bi-people"></i> Patients</h5>
                <p>Manage patient records and history.</p>
                <a href="/Patient" class="btn btn-outline-primary">Open</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5><i class="bi bi-person-badge"></i> Doctors</h5>
                <p>Manage doctors and availability.</p>
                <a href="/Doctor" class="btn btn-outline-success">Open</a>
            </div>
        </div>

        <div class="col-md-4">
            <div class="card shadow-sm p-4">
                <h5><i class="bi bi-calendar-check"></i> Appointments</h5>
                <p>Schedule and track appointments.</p>
                <a href="/Appointment" class="btn btn-outline-warning">Open</a>
            </div>
        </div>

    </div>

    <!-- TODAY'S APPOINTMENTS -->
    <div class="card shadow-sm p-3 mt-4">

        <h5 class="fw-bold mb-3">
            <i class="bi bi-calendar-check"></i> Today's Upcoming Appointments
        </h5>

        @if (ViewBag.TodayAppointments != null && ViewBag.TodayAppointments.Count > 0)
        {
            <ul class="list-group">

                @for (int i = 0; i < ViewBag.TodayAppointments.Count; i++)
                {
                    var a = ViewBag.TodayAppointments[i];

                    <li class="list-group-item d-flex justify-content-between align-items-center
                        @(i == 0 ? "list-group-item-success fw-bold" : "")">

                        <div>
                            <strong>@a.PatientName</strong> with
                            <span class="text-primary">@a.DoctorName</span>

                            @if (i == 0)
                            {
                                <span class="badge bg-success ms-2">Next</span>
                            }
                        </div>

                        <span class="badge bg-dark">
                            @a.TimeSlot.ToString(@"hh\:mm")
                        </span>
                    </li>
                }

            </ul>
        }
        else
        {
            <p class="text-muted mb-0">No upcoming appointments today</p>
        }

    </div>

    <div class="row mt-4">

        <!-- PIE CHART -->
        <div class="col-md-12">
            <div class="card p-3 shadow-sm">
                <h5 class="text-center">Appointment Status</h5>
                <div style="max-width: 500px; margin: auto;">
                    <canvas id="statusChart"></canvas>
                </div>
            </div>
        </div>

    </div>

</div>

@section Scripts {
    <script>
        const booked = @ViewBag.BookedCount;
        const completed = @ViewBag.CompletedCount;
        const cancelled = @ViewBag.CancelledCount;

        if (booked === 0 && completed === 0 && cancelled === 0) {
            document.getElementById("statusChart").parentElement.innerHTML =
                "<p class='text-center text-muted'>No appointment data available</p>";
        } else {

            // PIE CHART
            new Chart(document.getElementById("statusChart"), {
                type: 'pie',
                data: {
                    labels: ['Booked', 'Completed', 'Cancelled'],
                    datasets: [{
                        data: [booked, completed, cancelled],
                        backgroundColor: ['#0d6efd', '#198754', '#dc3545']
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: {
                            position: 'top'
                        }
                    }
                }
            });

        }
    </script>
}