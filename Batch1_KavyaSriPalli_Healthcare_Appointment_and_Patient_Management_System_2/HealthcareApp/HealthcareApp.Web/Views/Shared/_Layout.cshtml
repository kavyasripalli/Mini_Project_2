<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - MediSphere</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HealthcareApp.Web.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
</head>
<body>
    <header>
        @{
            var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
        }
        <nav class="navbar navbar-expand-lg navbar-dark shadow-sm" style="background: linear-gradient(90deg, #0f2027, #2c5364);">
            <div class="container-fluid">

                <!-- Logo -->
                <a class="navbar-brand fw-bold fs-4" asp-controller="Home" asp-action="Index">
                    MediSphere
                </a>

                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto">

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-speedometer2 me-1"></i> Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Patient" asp-action="Index">
                                <i class="bi bi-people-fill me-1"></i> Patients
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Doctor" asp-action="Index">
                                <i class="bi bi-person-badge-fill me-1"></i> Doctors
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link text-white" asp-controller="Appointment" asp-action="Index">
                                <i class="bi bi-calendar-check-fill me-1"></i> Appointments
                            </a>
                        </li>

                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container-fluid px-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark text-white mt-5">
        <div class="container text-center py-3">
            <p class="mb-0">
                &copy; 2026 MediSphere | Healthcare Management System
            </p>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <div id="toast" style="position: fixed; top: 20px; right: 20px; z-index: 9999;"></div>
    <script>
            function showToast(message, type) {
                var toast = document.createElement("div");
                toast.innerText = message;

                toast.style.padding = "10px 20px";
                toast.style.marginTop = "10px";
                toast.style.borderRadius = "5px";
                toast.style.color = "white";

                if (type === "success") {
                    toast.style.backgroundColor = "green";
                } else {
                    toast.style.backgroundColor = "red";
                }

                document.getElementById("toast").appendChild(toast);

                setTimeout(() => {
                    toast.remove();
                }, 3000);
            }
    </script>

    <script>
            window.onload = function () {
                var success = '@TempData["Success"]';
                var error = '@TempData["Error"]';

                if (success) {
                    showToast(success, "success");   // temporary (we will convert to toast later)
                }

                if (error) {
                    showToast(error, "error");
                }
            }
    </script>
</body>
</html>
